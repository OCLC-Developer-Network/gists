# OCLC API Credentials
OCLC_KEY=your_oclc_key_here
OCLC_SECRET=your_oclc_secret_here

# OCLC OAuth URLs
OCLC_TOKEN_URL=https://oauth.oclc.org/token
OCLC_AUTH_URL=https://oauth.oclc.org/auth

# Service URLs (optional - defaults provided)
METADATA_SERVICE_URL=https://metadata.api.oclc.org/worldcat/manage/bibs
WMS_AVAILABILITY_URL=https://circ.sd00.worldcat.org/availability

# Flask Configuration (for authCode examples)
FLASK_SECRET_KEY=your_secret_key_here

# Registry ID (for cross-institution auth)
OCLC_REGISTRY_ID=128807

